# 1. Rebuild lại frontend (do đã sửa code)
docker-compose restart frontend


# 2. Rebuild backend
docker-compose restart backend

# 2. Kiểm tra log
docker logs web_tool_frontend

# 3. Mở browser
http://localhost:3000

# 4. Đăng nhập: admin@example.com / admin123

# 5. Vào Upload Task, upload file JSON

# 6. Vào Dashboard, xem task vừa upload hiển thị