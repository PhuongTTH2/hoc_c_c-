CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE NOT NULL,
    username VARCHAR(100) UNIQUE NOT NULL,
    full_name VARCHAR(255),
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(20) DEFAULT 'USER', -- ADMIN, USER, VIEWER
    
    -- Jira credentials (encrypted)
    jira_account_id VARCHAR(100),
    jira_display_name VARCHAR(255),
    jira_email VARCHAR(255),
    
    -- Preferences
    preferences JSONB DEFAULT '{}',
    
    -- Timestamps
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    last_login TIMESTAMP,
    is_active BOOLEAN DEFAULT true
);

CREATE TABLE tasks (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    task_key VARCHAR(50) UNIQUE NOT NULL, -- TASK-001, AUTO-001
    
    -- Basic information
    name VARCHAR(500) NOT NULL,
    description TEXT,
    status VARCHAR(50) DEFAULT 'DRAFT', -- DRAFT, PENDING, IN_PROGRESS, COMPLETED, FAILED, CANCELLED
    priority VARCHAR(20) DEFAULT 'MEDIUM', -- LOW, MEDIUM, HIGH, CRITICAL
    
    -- ⭐⭐⭐ 4 ID LIÊN KẾT QUAN TRỌNG ⭐⭐⭐
    jira_id UUID,
    git_id UUID,
    sharepoint_id UUID,
    confluence_id UUID,
    
    -- User who created/executed
    created_by UUID REFERENCES users(id),
    executed_by UUID REFERENCES users(id),
    
    -- Timestamps
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    scheduled_at TIMESTAMP,
    executed_at TIMESTAMP,
    completed_at TIMESTAMP,
    
    -- Metadata
    metadata JSONB DEFAULT '{}'
);

-- Indexes
CREATE INDEX idx_tasks_status ON tasks(status);
CREATE INDEX idx_tasks_created_by ON tasks(created_by);
CREATE INDEX idx_tasks_priority ON tasks(priority);
CREATE INDEX idx_tasks_created_at ON tasks(created_at);



CREATE TABLE jira_details (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    -- Jira identification
    jira_ticket_key VARCHAR(50) UNIQUE NOT NULL, -- PROJ-123
    jira_ticket_id VARCHAR(50), -- Internal Jira ID
    jira_ticket_url VARCHAR(500),
    
    -- ⭐ Task information from Jira ⭐
    task_name VARCHAR(500) NOT NULL, -- Tên task trên Jira
    task_description TEXT, -- Mô tả task
    
    -- ⭐ People ⭐
    created_by VARCHAR(255), -- Người tạo task (Jira display name)
    created_by_account_id VARCHAR(100), -- Jira account ID
    assignee_name VARCHAR(255), -- Người được giao
    assignee_account_id VARCHAR(100),
    reporter_name VARCHAR(255), -- Người báo cáo
    reporter_account_id VARCHAR(100),
    
    -- ⭐ Dates ⭐
    start_date DATE, -- Ngày bắt đầu
    due_date DATE, -- Ngày kết thúc (end date)
    jira_created_date TIMESTAMP, -- Ngày tạo trên Jira
    jira_updated_date TIMESTAMP, -- Ngày cập nhật
    resolution_date TIMESTAMP, -- Ngày giải quyết
    
    -- ⭐ Priority ⭐
    priority VARCHAR(50), -- Highest, High, Medium, Low, Lowest
    
    -- Additional Jira fields
    issue_type VARCHAR(50), -- Task, Bug, Story, Epic
    project_key VARCHAR(50),
    project_name VARCHAR(255),
    status VARCHAR(50), -- To Do, In Progress, Done
    status_category VARCHAR(50), -- To Do, In Progress, Done
    
    -- Custom fields
    custom_fields JSONB DEFAULT '{}',
    
    -- Labels and components
    labels JSONB DEFAULT '[]',
    components JSONB DEFAULT '[]',
    
    -- Full response from Jira API
    raw_response JSONB DEFAULT '{}',
    
    -- Sync info
    last_sync_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    is_synced BOOLEAN DEFAULT true,
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Indexes for quick search
CREATE INDEX idx_jira_ticket_key ON jira_details(jira_ticket_key);
CREATE INDEX idx_jira_assignee ON jira_details(assignee_account_id);
CREATE INDEX idx_jira_status ON jira_details(status);
CREATE INDEX idx_jira_priority ON jira_details(priority);
CREATE INDEX idx_jira_start_date ON jira_details(start_date);
CREATE INDEX idx_jira_due_date ON jira_details(due_date);
CREATE INDEX idx_jira_created_date ON jira_details(jira_created_date);


CREATE TABLE git_details (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    -- Branch information
    branch_name VARCHAR(255) NOT NULL,
    branch_url VARCHAR(500),
    branch_sha VARCHAR(100),
    
    -- Repository
    repo_url VARCHAR(500),
    repo_name VARCHAR(255),
    repo_owner VARCHAR(255),
    base_branch VARCHAR(100) DEFAULT 'main',
    
    -- Commit
    commit_message TEXT,
    commit_url VARCHAR(500),
    commit_sha VARCHAR(100),
    commit_author VARCHAR(255),
    commit_date TIMESTAMP,
    
    -- Provider
    provider VARCHAR(20) DEFAULT 'GITHUB', -- GITHUB, GITLAB, BITBUCKET
    
    -- Webhook
    webhook_url VARCHAR(500),
    webhook_secret VARCHAR(255),
    
    -- Pull Request (if created)
    pr_number INTEGER,
    pr_url VARCHAR(500),
    pr_status VARCHAR(50),
    
    raw_response JSONB DEFAULT '{}',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_git_branch_name ON git_details(branch_name);
CREATE INDEX idx_git_repo ON git_details(repo_name);


CREATE TABLE sharepoint_details (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    -- Folder information
    folder_name VARCHAR(255) NOT NULL,
    folder_path VARCHAR(500),
    folder_url VARCHAR(500),
    folder_id VARCHAR(100),
    
    -- Site information
    site_url VARCHAR(500),
    site_id VARCHAR(100),
    site_name VARCHAR(255),
    drive_id VARCHAR(100),
    document_library VARCHAR(255),
    
    -- Template
    template_file_id VARCHAR(100),
    template_name VARCHAR(255),
    template_url VARCHAR(500),
    copied_file_id VARCHAR(100),
    copied_file_name VARCHAR(255),
    copied_file_url VARCHAR(500),
    
    -- Permissions
    permissions JSONB DEFAULT '{}',
    
    raw_response JSONB DEFAULT '{}',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_sharepoint_folder ON sharepoint_details(folder_path);



CREATE TABLE execution_logs (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    task_id UUID REFERENCES tasks(id) ON DELETE CASCADE,
    
    execution_number INTEGER,
    triggered_by UUID REFERENCES users(id),
    trigger_type VARCHAR(20) DEFAULT 'MANUAL', -- MANUAL, SCHEDULED, WEBHOOK
    
    status VARCHAR(20) DEFAULT 'PENDING', -- PENDING, RUNNING, SUCCESS, PARTIAL, FAILED
    
    -- Results from each integration
    jira_result JSONB DEFAULT '{}',
    git_result JSONB DEFAULT '{}',
    sharepoint_result JSONB DEFAULT '{}',
    confluence_result JSONB DEFAULT '{}',
    
    started_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    completed_at TIMESTAMP,
    duration_ms FLOAT,
    
    error_message TEXT,
    failed_step VARCHAR(50),
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_execution_task ON execution_logs(task_id);
CREATE INDEX idx_execution_status ON execution_logs(status);
CREATE INDEX idx_execution_started ON execution_logs(started_at);


CREATE TABLE notifications (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id),
    task_id UUID REFERENCES tasks(id),
    execution_id UUID REFERENCES execution_logs(id),
    
    type VARCHAR(20), -- SUCCESS, ERROR, WARNING, INFO
    title VARCHAR(255),
    message TEXT,
    
    is_read BOOLEAN DEFAULT false,
    read_at TIMESTAMP,
    
    channels JSONB DEFAULT '["web"]', -- web, email, slack
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX idx_notification_user ON notifications(user_id);
CREATE INDEX idx_notification_read ON notifications(is_read);


CREATE TABLE sync_history (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    
    sync_type VARCHAR(50), -- FULL, INCREMENTAL
    project_keys JSONB DEFAULT '[]',
    
    status VARCHAR(20), -- RUNNING, SUCCESS, FAILED
    
    tasks_synced INTEGER DEFAULT 0,
    tasks_created INTEGER DEFAULT 0,
    tasks_updated INTEGER DEFAULT 0,
    
    started_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    completed_at TIMESTAMP,
    
    error_message TEXT,
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);



