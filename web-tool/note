# Mở PowerShell
docker --version
# Kết quả: Docker version 24.0.7, build ...

docker-compose --version
# Kết quả: Docker Compose version v2.23.0

# Chạy thử
docker run hello-world


mkdir backend frontend nginx scripts

Build và chạy
docker-compose up -d --build


# Xem các container đang chạy
docker-compose ps

# Xem log của backend
docker-compose logs backend

# Xem log của frontend
docker-compose logs frontend


# Khởi động lại tất cả
docker-compose restart

# Xem log real-time
docker-compose logs -f

# Dừng tất cả
docker-compose down

# Dừng và xóa database (cẩn thận)
docker-compose down -v

# Chạy command trong container backend
docker-compose exec backend bash

# Truy cập database
docker-compose exec postgres psql -U webuser -d web_tool_db


# Khởi động tất cả services
docker-compose up -d

http://localhost:3000	Frontend - Giao diện web
http://localhost:8000	Backend API
http://localhost:8000/docs	API Documentation (Swagger)
http://localhost:8000/health	Health check



cd D:\hoc_c_c++\hoc_c_c-Web-tool

# Dừng container
docker-compose down

# Xóa image cũ
docker rmi web-tool-frontend

# Build lại
docker-compose build --no-cache frontend

# Chạy lại
docker-compose up -d

#stop
docker-compose down

# Kiểm tra log
docker logs web_tool_frontend

# Kết nối vào database container
docker exec -it web_tool_postgres psql -U webuser -d web_tool_db




1. Vào Jira → Project Settings → Webhooks
2. Thêm webhook mới:
   - URL: https://your-domain.com/webhooks/jira
   - Events: Chọn "Issue updated", "Issue status changed"
3. Lưu lại

1. Vào Repository → Settings → Webhooks
2. Add webhook:
   - Payload URL: https://your-domain.com/webhooks/git
   - Content type: application/json
   - Events: Chọn "Push events", "Pull request events"
3. Lưu lại


┌─────────────────────────────────────────────────────────────────────────────┐
│                              JIRA / GIT                                     │
│                                                                             │
│  Khi có thay đổi (status, push code)                                        │
│  └─────────────────────────────────────────────────────────────────────────┘
│                                    │
│                                    │ Webhook (HTTP POST)
│                                    ▼
┌─────────────────────────────────────────────────────────────────────────────┐
│                         BACKEND (FastAPI)                                   │
│  ┌─────────────────────────────────────────────────────────────────────┐   │
│  │  /webhooks/jira  ──► Nhận webhook, cập nhật DB                      │   │
│  │  /webhooks/git   ──► Nhận webhook, cập nhật DB                      │   │
│  └─────────────────────────────────────────────────────────────────────┘   │
│                                    │                                        │
│                                    │ WebSocket broadcast                   │
│                                    ▼                                        │
│  ┌─────────────────────────────────────────────────────────────────────┐   │
│  │  WebSocket Manager ──► Gửi update đến tất cả client                 │   │
│  └─────────────────────────────────────────────────────────────────────┘   │
└─────────────────────────────────────────────────────────────────────────────┘
                                    │
                                    │ WebSocket (real-time)
                                    ▼
┌─────────────────────────────────────────────────────────────────────────────┐
│                         FRONTEND (React)                                    │
│                                                                             │
│  ┌─────────────────────────────────────────────────────────────────────┐   │
│  │  WebSocket Client ──► Nhận update, cập nhật UI ngay lập tức        │   │
│  │                     ──► Hiển thị notification                       │   │
│  │                     ──► Refresh dashboard                           │   │
│  └─────────────────────────────────────────────────────────────────────┘   │
└─────────────────────────────────────────────────────────────────────────────┘


